{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창과 콘솔 팝아웃: 셸 명령과 이벤트 수신",
  "windows": [
    "main",
    "popout-*"
  ],
  "permissions": [
    "core:default",
    "allow-daemon-request",
    "allow-daemon-stream-open",
    "allow-daemon-stream-close",
    "allow-app-ready",
    "allow-daemon-status",
    "allow-daemon-restart",
    "allow-app-close-response",
    "allow-updater-launch-apply",
    "allow-updater-restart",
    "allow-updater-rollback",
    "allow-launch-uninstaller",
    "allow-settings-local-load",
    "allow-settings-local-save",
    "allow-settings-get-path",
    "allow-refresh-ipc-base",
    "allow-language-get",
    "allow-language-set",
    "allow-daemon-target-get",
    "allow-daemon-target-set",
    "allow-dialog-open-file",
    "allow-dialog-open-folder",
    "allow-dialog-save-file",
    "allow-shell-open-external",
    "allow-shell-open-path",
    "allow-logs-open-folder",
    "allow-app-get-version",
    "allow-notify",
    "allow-sound-play",
    "allow-console-popout",
    "allow-console-popout-list",
    "allow-console-popin",
    "allow-console-popout-close",
    "allow-console-popout-saved",
    "allow-console-toggle-always-on-top",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-window-minimize",
    "allow-window-maximize",
    "allow-window-is-maximized",
    "allow-window-close",
    "allow-window-set-background",
    "allow-window-set-backdrop",
    "allow-sandbox-consent-allow",
    "allow-overlay-state",
    "allow-overlay-set-enabled",
    "allow-overlay-sync"
  ]
}