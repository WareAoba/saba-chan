<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 맥 앱 묶음(Saba-chan.app)의 Info.plist. .dmg 묶음(.github/scripts/package-macos.py)과 설치기가 함께 쓴다.
     @VERSION@은 릴리즈 버전, @BUILD@는 그 숫자 부분(CFBundleVersion은 숫자와 점만 받는다)으로 바꾼다 -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleDisplayName</key>
	<string>Saba-chan</string>
	<key>CFBundleExecutable</key>
	<string>saba-chan-gui</string>
	<key>CFBundleIconFile</key>
	<string>saba-chan.icns</string>
	<key>CFBundleIdentifier</key>
	<string>com.saba-chan.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Saba-chan</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
